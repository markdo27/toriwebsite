# Copy this file to .env and fill in real values. .env is git-ignored.
# For a Vercel deployment, most of this is auto-filled instead — see README.md.

PORT=5183

# Postgres connection string for bookings and photo state.
# On Vercel: Storage tab -> Create Database -> Postgres -> Connect to Project.
# This env var is then injected automatically in production. For local dev,
# run `vercel env pull .env.local` after connecting it (or point this at any
# Postgres instance, e.g. a free one from Neon or Supabase, for local testing).
POSTGRES_URL=

# Vercel Blob token for photo uploads.
# On Vercel: Storage tab -> Create -> Blob -> Connect to Project.
# Also auto-injected in production; use `vercel env pull .env.local` locally.
BLOB_READ_WRITE_TOKEN=

# Long random string used to sign admin login cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin login (the restaurant owner's dashboard at /admin).
# Set the password hash with: npm run hash-password -- "your-new-password"
ADMIN_USERNAME=owner
ADMIN_PASSWORD_HASH=

# Where new-booking notification emails are sent.
OWNER_EMAIL=owner@example.com

# SMTP settings used to send booking notification emails.
# Works with Gmail (use an "App Password", not your normal password),
# Outlook/Office365, or any transactional email provider (Resend, SendGrid, etc.
# via their SMTP relay).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
